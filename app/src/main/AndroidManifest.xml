<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No INTERNET permission on purpose: every report is uploaded through the Karoo
      System's own connection (wifi, or BT to the companion app), see OnHttpResponse.
    -->

    <application
        android:name=".SaftladenApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_saftladen"
        android:label="@string/app_name"
        android:theme="@style/Theme.Saftladen">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="io.github.hamann.saftladen.MAIN" />
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".extension.SaftladenExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Required for this extension to be discovered by the Karoo System -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <!-- Required for this extension to define resources and definitions -->
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Where the Karoo System looks to find out that an update exists.
             The release workflow writes this manifest.json and attaches it to
             the GitHub release. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/hamann/karoo-saftladen/releases/latest/download/manifest.json" />

    </application>

</manifest>
